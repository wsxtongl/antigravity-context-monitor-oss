{
  "name": "antigravity-context-monitor",
  "version": "1.3.0",
  "description": "Read-only, zero-modification MCP App plugin for Google Antigravity 2.0 to monitor context window usage, cache hit rate, token trends, and estimated API costs.",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "install:local": "node scripts/build.js --install",
    "test": "node --test tests/smoke.test.js",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "antigravity",
    "mcp",
    "mcp-app",
    "plugin",
    "context-window",
    "token-monitor",
    "gemini"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
